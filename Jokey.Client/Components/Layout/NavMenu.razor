@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Jokey</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <Login />
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="jokes">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Jokes
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="jokes2">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> More Jokes
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code
{
    private readonly AuthenticationStateProvider _authenticationStateProvider;
    private DotNetObjectReference<NavMenu>? _dotNetReference;
    private IJSObjectReference? _module;
    private readonly IToastService _toastService;

    public NavMenu(AuthenticationStateProvider authenticationStateProvider, IToastService toastService)
    {
        _authenticationStateProvider = authenticationStateProvider ?? throw new ArgumentNullException(nameof(authenticationStateProvider));
        _toastService = toastService ?? throw new ArgumentNullException(nameof(toastService));

        _authenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    public async ValueTask DisposeAsync()
    {
        _authenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;

        await StopNotificationsAsync();

        _dotNetReference?.Dispose();
        if (_module is not null)
        {
            try 
            {
                await _module.DisposeAsync();
            }
            catch 
            { }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var authState = await _authenticationStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/scripts/notification-service.js");
        _dotNetReference ??= DotNetObjectReference.Create(this);

        await _module.InvokeVoidAsync(
                        "startNotifications",
                        "/notifications",
                        _dotNetReference);
    }

    [JSInvokable]
    public void ReceiveNotification(Notification notification)
    {
        _toastService.ShowInfo(notification.Message);
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var state = await task;
        if (!(state.User.Identity?.IsAuthenticated ?? false))
        {
            await StopNotificationsAsync();
        }
    }

    private void ShowNotification(Notification notification)
    {
        _toastService.ShowInfo(notification.Message);
    }

    private async Task StopNotificationsAsync()
    {
        if (_module is null)
        {
            return;
        }

        // Call stopNotifications to disconnect from the hub swallowing any exceptions that may occur
        try
        {
            await _module.InvokeVoidAsync("stopNotifications");
        }
        catch
        { }
    }
}